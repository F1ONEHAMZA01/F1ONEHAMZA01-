/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-2xVv2gsnNFjPALQ8FfkNeqLRNzcnl0rv0TxJePw/dcw=' 'sha256-SiMDMSfr9NTT2e9NabzPvOpwsMiY3MeKhXRfML7f3rw='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, no-cache, must-revalidate
  Service-Worker-Allowed: /

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/deploy-metadata.json
  Cache-Control: no-store

/data/vocab.js
  Cache-Control: public, max-age=31536000, immutable

/data/reading-docs.js
  Cache-Control: public, max-age=31536000, immutable

/data/writing-templates.js
  Cache-Control: public, max-age=31536000, immutable

/data/grammar-lessons.js
  Cache-Control: public, max-age=31536000, immutable

/data/plan-tasks.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable
